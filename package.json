{
  "name": "loud-weekend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prisma:generate": "prisma generate",
    "postinstall": "npm run prisma:generate",
    "pretypecheck": "npm run prisma:generate",
    "build": "next build",
    "prebuild": "npm run prisma:generate",
    "typecheck": "tsc --noEmit",
    "check:sources": "node scripts/check-festival-sources.mjs",
    "ingestion:review-queue": "node scripts/export-ingestion-review-queue.mjs",
    "test:ingestion-review-queue": "node --test tests/ingestion-review-queue.test.mjs",
    "ingest": "node scripts/ingest-festivals.mjs",
    "timetables:import": "node scripts/import-timetable.mjs",
    "venues:import": "node scripts/import-venue.mjs",
    "enrich:artists": "node scripts/enrich-artists.mjs",
    "test:artist-enrichment": "node --experimental-strip-types --test tests/artist-enrichment-publication.test.mjs tests/artist-enrichment.test.mjs",
    "test:artist-enrichment-db": "node --experimental-strip-types --test tests/artist-enrichment-publication.e2e.test.mjs",
    "resolve:artists": "node scripts/resolve-artist-identities.mjs",
    "test:data": "node --import tsx --test $(find tests -maxdepth 1 -name '*.test.mjs' ! -name '*.e2e.test.mjs' -print) && node --experimental-strip-types --test tests/artist-lineup-sorts.test.ts && node --import tsx --test tests/domain-boundary.test.ts tests/source-configuration.test.ts tests/playlist-queue.test.ts tests/public-detail-copy.test.tsx && npm run test:logo-serving",
    "test:routes": "node scripts/test-locale-routes.mjs",
    "test:ingestion-db": "node --test tests/ingestion-repository.e2e.test.mjs",
    "notifications:drain-db-due": "node scripts/drain-ingestion-notifications.mjs --db-due",
    "test:playlist-queue": "node --import tsx --test tests/playlist-queue.e2e.test.ts",
    "test:logo-assets": "node --import tsx --test tests/logo-assets.e2e.test.ts",
    "test:logo-serving": "node --import tsx --test tests/logo-serving.test.ts tests/festival-logo.test.ts",
    "test:logo-serving-db": "node --import tsx --test tests/logo-serving.e2e.test.ts",
    "test:due-worker": "node --import tsx --test --test-concurrency=1 tests/ingestion-due-worker.e2e.test.mjs tests/db-due-health.e2e.test.mjs",
    "test:sources": "node --import tsx --test tests/source-configuration.test.ts tests/source-repository.e2e.test.ts",
    "test:catalog-db": "node --import tsx --test --test-concurrency=1 tests/catalog-repository.e2e.test.ts tests/catalog-publication.e2e.test.ts tests/artist-aliases.e2e.test.mjs tests/ingestion-lease.e2e.test.ts tests/spotify-repertoire.e2e.test.mjs tests/selection-playlist-canonical.e2e.test.ts tests/group-trips.e2e.test.ts",
    "test:integration": "node --test --test-concurrency=1 tests/integration/account-routes.test.mjs tests/integration/notification-routes.test.mjs tests/integration/admin-workflows.test.mjs",
    "test:notifications:e2e": "node tests/notification-e2e.mjs",
    "test:admin:integration": "node --test --test-concurrency=1 tests/integration/admin-workflows.test.mjs",
    "test:admin:e2e": "playwright test",
    "analytics:prune": "node scripts/prune-analytics.mjs",
    "playlists:catalog": "node scripts/export-playlist-catalog.mjs",
    "test": "python3 -m unittest discover -s tests",
    "test:admin-auth": "node --import tsx --test tests/admin-auth.test.ts",
    "admin:assign-role": "node scripts/assign-admin-role.mjs",
    "playlists:worker": "tsx scripts/playlist-provider-worker.ts",
    "test:seed": "tsx tests/support/seed-database.ts",
    "catalog:audit": "tsx scripts/audit-catalog.ts",
    "test:runtime": "node --import tsx --test tests/production-release.test.mjs tests/playlist-provider-lock.test.mjs tests/provider-timers.test.mjs tests/logo-serving.test.ts tests/festival-logo.test.ts && python3 -m unittest discover -s tests -p test_playlist_plan.py",
    "test:persistence-db": "node --import tsx --test tests/catalog-persistence.e2e.test.ts",
    "pretest:persistence-db": "node scripts/prepare-test-db.mjs",
    "artists:add-alias": "node scripts/add-artist-aliases.mjs",
    "lineup-days:import": "node scripts/import-lineup-days.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:format && npm run lint:lines",
    "lint:js": "oxlint --deny-warnings",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "csslint": "npm run lint:css",
    "lint:lines": "node scripts/check-line-length.mjs",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,jsx,mts,cts,css}\"",
    "lint:format": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,jsx,mts,cts,css}\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "1.2.0",
    "dotenv": "^18.0.10",
    "jose": "^6.2.18",
    "maplibre-gl": "6.19.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "supercluster": "9.1.0",
    "topojson-client": "3.1.0",
    "typescript": "^7.0.2",
    "world-atlas": "2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/supercluster": "7.1.3",
    "@types/topojson-client": "3.1.5",
    "esbuild": "^0.28.2",
    "oxlint": "1.95.0",
    "postcss": "8.5.23",
    "prettier": "3.10.1",
    "robots-parser": "3.0.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "effect": "3.22.2"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
